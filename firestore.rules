rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOrganizer() {
      return request.auth != null && getUserRole() == 'organizer';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();      // any logged-in user can view
      allow create, update, delete: if isOrganizer(); // only organizers can modify
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId; // users can only edit their own profile
    }

    // ── Registrations ──────────────────────────────────────────────
    // Any authenticated user can read registrations.
    // Any authenticated user can create a registration (students register for events).
    // A user can only delete their own registration (unregister).
    match /registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Attendance ─────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ── Reports ────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
